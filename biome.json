{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useImportExtensions": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/app/*/**", "**/app/*/**"],
                "message": "App subfolders are private: from outside src/app import only the modules at its root (program.ts, view.ts, *.layer.ts)."
              },
              {
                "group": ["@/app/pages/*/*/**", "**/pages/*/*/**"],
                "message": "Page subfolders are private: import only the modules at the root of the page (program.ts, view.ts, *.layer.ts)."
              },
              {
                "group": ["fast-check", "**/*.arbitrary.ts", "@/libs/testing/**"],
                "message": "Test-only code: fast-check, *.arbitrary.ts and libs/testing may only be imported by *.test.ts and *.arbitrary.ts files."
              }
            ]
          }
        }
      },
      "suspicious": { "recommended": false },
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["src/app/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/*/**", "**/app/*/**"],
                    "message": "App subfolders are private: from outside src/app import only the modules at its root (program.ts, view.ts, *.layer.ts)."
                  },
                  {
                    "group": ["@/app/pages/*/*/**", "**/pages/*/*/**"],
                    "message": "Page subfolders are private: import only the modules at the root of the page (program.ts, view.ts, *.layer.ts)."
                  },
                  {
                    "group": ["fast-check", "**/*.arbitrary.ts", "@/libs/testing/**"],
                    "message": "Test-only code: fast-check, *.arbitrary.ts and libs/testing may only be imported by *.test.ts and *.arbitrary.ts files."
                  },
                  {
                    "group": ["../../adapters/**", "../../../adapters/**", "../../../../adapters/**"],
                    "message": "Pages use the domain and ports of src/app, never its adapters: the root *.layer.ts files provide them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/domain/**", "src/app/ports/**", "src/app/adapters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/*/**", "**/app/*/**"],
                    "message": "App subfolders are private: from outside src/app import only the modules at its root (program.ts, view.ts, *.layer.ts)."
                  },
                  {
                    "group": ["fast-check", "**/*.arbitrary.ts", "@/libs/testing/**"],
                    "message": "Test-only code: fast-check, *.arbitrary.ts and libs/testing may only be imported by *.test.ts and *.arbitrary.ts files."
                  },
                  {
                    "group": ["**/pages/**"],
                    "message": "The domain, ports and adapters of src/app never depend on a page: pages depend on them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.arbitrary.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/*/**", "**/app/*/**"],
                    "message": "App subfolders are private: from outside src/app import only the modules at its root (program.ts, view.ts, *.layer.ts)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
