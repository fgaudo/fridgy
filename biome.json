{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useImportExtensions": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "#app/*/**",
                  "**/app/*/**"
                ],
                "message": "App subfolders are private: from outside src/app import only the modules at its root (program.ts, view.ts, *.layer.ts)."
              },
              {
                "group": [
                  "#app/pages/*/*/**",
                  "**/pages/*/*/**"
                ],
                "message": "Page subfolders are private: import only the modules at the root of the page (program.ts, view.ts, *.layer.ts)."
              },
              {
                "group": [
                  "fast-check",
                  "**/*.test_*.ts",
                  "@fgaudo/effect-tea/testing"
                ],
                "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
              },
              {
                "group": [
                  "../../../**"
                ],
                "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #libs/…, #infrastructure/…)."
              }
            ]
          }
        }
      },
      "suspicious": {
        "preset": "none"
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/app/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#app/pages/*/*/**",
                      "**/pages/*/*/**"
                    ],
                    "message": "Page subfolders are private: import only the modules at the root of the page (program.ts, view.ts, *.layer.ts)."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/pages/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#app/pages/**"
                    ],
                    "message": "Pages never import each other, and a page reaches its own files through relative imports."
                  },
                  {
                    "group": [
                      "#app/adapters/**"
                    ],
                    "message": "Pages use the domain and ports of src/app, never its adapters: the root *.layer.ts files provide them."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/domain/**",
        "src/app/ports/**",
        "src/app/adapters/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#app/pages/**",
                      "**/pages/**"
                    ],
                    "message": "The domain, ports and adapters of src/app never depend on a page: pages depend on them."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test_*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {},
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
