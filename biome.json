{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useImportExtensions": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "#app/*/**",
                  "**/app/*/**"
                ],
                "message": "From outside src/app, import only the modules at its root (program.ts, view.tsx, layer.ts)."
              },
              {
                "group": [
                  "fast-check",
                  "**/*.test_*.ts",
                  "@fgaudo/effect-tea/testing"
                ],
                "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
              },
              {
                "group": [
                  "../../../**"
                ],
                "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
              }
            ]
          }
        }
      },
      "suspicious": {
        "preset": "none"
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "off",
            "useValidAnchor": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/entrypoints/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#app/*/**",
                      "!#app/**/*.*.ts",
                      "#app/**/*.test.ts",
                      "#app/**/*.test_*.ts"
                    ],
                    "message": "An entrypoint imports from src/app its root modules (program.ts, view.tsx, layer.ts) and the adapters it picks (<service>.<backing>.ts); nothing else."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**"
                    ],
                    "message": "A program knows only its own folder: an import never goes up to a parent or across to a sibling (another page, another part, another service)."
                  },
                  {
                    "group": [
                      "#app/**"
                    ],
                    "message": "Inside src/app, files reach each other through relative imports, downwards."
                  },
                  {
                    "group": [
                      "**/pages/*/*/**"
                    ],
                    "message": "The root reaches a page only through the modules at the page's root (program.ts, view.tsx, layer.ts)."
                  },
                  {
                    "group": [
                      "**/*.*.ts"
                    ],
                    "message": "Adapters (<service>.<backing>.ts) are imported only by a layer.ts, an entrypoint or their own test: a program uses its services."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/**/layer.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**"
                    ],
                    "message": "A program knows only its own folder: an import never goes up to a parent or across to a sibling (another page, another part, another service)."
                  },
                  {
                    "group": [
                      "#app/**"
                    ],
                    "message": "Inside src/app, files reach each other through relative imports, downwards."
                  },
                  {
                    "group": [
                      "**/pages/*/*/**"
                    ],
                    "message": "The root reaches a page only through the modules at the page's root (program.ts, view.tsx, layer.ts)."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/domain/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#app/**",
                      "**/app/**",
                      "#infrastructure/**",
                      "**/infrastructure/**"
                    ],
                    "message": "The domain depends on nothing but libs: the app and the infrastructure depend on it."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/infrastructure/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#app/**",
                      "**/app/**"
                    ],
                    "message": "The infrastructure never depends on the app: the app's adapters depend on it."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/libs/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#app/**",
                      "#domain/**",
                      "#infrastructure/**"
                    ],
                    "message": "src/libs is generic: it knows nothing of the app, its domain or its infrastructure."
                  },
                  {
                    "group": [
                      "fast-check",
                      "**/*.test_*.ts",
                      "@fgaudo/effect-tea/testing"
                    ],
                    "message": "Test-only code: fast-check, *.test_*.ts files (arbitraries, contracts, test support) and @fgaudo/effect-tea/testing may only be imported by *.test.ts and *.test_*.ts files."
                  },
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test_*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../../../**"
                    ],
                    "message": "Relative imports stay within their part of the project: reach another part through its alias (#app/…, #domain/…, #libs/…, #infrastructure/…)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {},
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
