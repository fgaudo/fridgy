{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "topLevelNamedReexports": "follow",
        "namespaceImportPackages": ["effect"],
        // The unstable APIs of effect/sql and platform-browser are reported, but only an error fails the typecheck.
        "ignoreEffectWarningsInTscExitCode": true,

        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "deterministicKeys": "error",
          "extendsNativeError": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "error",
          "globalDate": "warning",
          "globalDateInEffect": "error",
          "globalFetch": "warning",
          "globalFetchInEffect": "error",
          "globalRandom": "warning",
          "globalRandomInEffect": "error",
          "globalTimers": "warning",
          "globalTimersInEffect": "error",
          "instanceOfSchema": "error",
          "nodeBuiltinImport": "error",
          "preferSchemaOverJson": "warning",
          "strictBooleanExpressions": "error"
        },
        "keyPatterns": [
          {
            "target": "service",
            "pattern": "default-hashed"
          }
        ],
        "importAliases": {
          "Array": "Arr",
          "Request": "Req",
          "Option": "Opt"
        }
      }
    ],
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "preserve",
    "moduleDetection": "force",
    "allowJs": false,

    // Views are TSX, rendered by snabbdom through src/libs/jsx/jsx-runtime.ts.
    "jsx": "react-jsx",
    "jsxImportSource": "#libs/jsx",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noErrorTruncation": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": true,
    "types": ["snabbdom", "bun"]
  },
  "include": ["src/**/*", "scripts/**/*"]
}
