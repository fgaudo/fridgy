{
	"compilerOptions": {
		"jsx": "react",
		"jsxFactory": "jsx",
		"jsxFragmentFactory": "Fragment",

		"plugins": [
			{
				"name": "@effect/language-service",
				"topLevelNamedReexports": "follow",
				"namespaceImportPackages": ["effect"],
				"diagnosticSeverity": {
					"deterministicKeys": "error",
					"importFromBarrel": "error",
					"missedPipeableOpportunity": "warn",
					"schemaUnionOfLiterals": "warn",
					"strictBooleanExpressions": "error",
					"nodeBuiltinImport": "error",
					"globalTimersInEffect": "error",
					"instanceOfSchema": "error",
					"globalRandomInEffect": "error",
					"globalFetchInEffect": "error",
					"globalDateInEffect": "error",
					"globalConsoleInEffect": "error",
					"extendsNativeError": "warn",
					"anyUnknownInErrorContext": "error"
				},
				"keyPatterns": [
					{
						"target": "service",
						"pattern": "default-hashed"
					}
				],
				"importAliases": {
					"Array": "Arr",
					"Request": "Req",
					"Option": "Opt"
				}
			}
		],

		"paths": {
			"@/core/*": ["./src/core/*"],
			"@/business/*": ["./src/business/*"],
			"@/ports/*": ["./src/business/ports/*"],
			"@/adapters/*": ["./src/business/adapters/*"],
			"@/use-cases/*": ["./src/business/use-cases/*"],
			"@/domain/*": ["./src/business/domain/*"],
			"@/screen/*": ["./src/screen/*"]
		},
		// Environment setup & latest features
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"allowJs": true,

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": true
	},
	"include": ["src", "scripts"]
}
