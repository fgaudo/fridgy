{
	"$schema": "./node_modules/@effect/language-service/schema.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@herp-inc/snabbdom-jsx",
		"plugins": [
			{
				"name": "@effect/language-service",
				"topLevelNamedReexports": "follow",
				"namespaceImportPackages": ["effect"],
				"diagnosticSeverity": {
					"anyUnknownInErrorContext": "error",
					"deterministicKeys": "error",
					"extendsNativeError": "warning",
					"globalConsole": "warning",
					"globalConsoleInEffect": "error",
					"globalDate": "warning",
					"globalDateInEffect": "error",
					"globalFetch": "warning",
					"globalFetchInEffect": "error",
					"globalRandom": "warning",
					"globalRandomInEffect": "error",
					"globalTimers": "warning",
					"globalTimersInEffect": "error",
					"importFromBarrel": "error",
					"instanceOfSchema": "error",
					"nodeBuiltinImport": "error",
					"preferSchemaOverJson": "warning",
					"strictBooleanExpressions": "error"
				},
				"keyPatterns": [
					{
						"target": "service",
						"pattern": "default-hashed"
					}
				],
				"importAliases": {
					"Array": "Arr",
					"Request": "Req",
					"Option": "Opt"
				}
			}
		],
		"paths": {
			"@/core/*": ["./src/core/*"],
			"@/business/*": ["./src/business/*"],
			"@/ports/*": ["./src/ports/*"],
			"@/adapters/*": ["./src/adapters/*"],
			"@/use-cases/*": ["./src/use-cases/*"],
			"@/domain/*": ["./src/domain/*"],
			"@/ui/*": ["./src/ui/*"]
		},
		// Environment setup & latest features
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "preserve",
		"moduleDetection": "force",
		"allowJs": false,

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": true,
		"noErrorTruncation": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": true,
		"types": ["snabbdom", "bun"]
	},

	"include": ["src/**/*", "scripts/**/*"]
}
