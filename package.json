{
  "name": "fridgy",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "imports": {
    "#app/*": "./src/app/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#libs/jsx/jsx-runtime": "./src/libs/jsx/jsx-runtime.ts",
    "#libs/jsx/jsx-dev-runtime": "./src/libs/jsx/jsx-dev-runtime.ts",
    "#libs/*": "./src/libs/*"
  },
  "scripts": {
    "update-licenses": "license-checker-rseidelsohn --excludePackages fridgy --json --customPath scripts/licenses.custom-path.json --out src/app/pages/about/adapters/licenses/generated/licenses.json --depth 0",
    "build": "bun ./scripts/cli.ts build",
    "watch": "bun ./scripts/cli.ts watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts",
    "test": "bun test",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@effect/platform-browser": "^4.0.5",
    "@effect/platform-bun": "^4.0.5",
    "@effect/sql-sqlite-wasm": "^4.0.5",
    "@fgaudo/effect-tea": "^0.5.1",
    "@fontsource-variable/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-gujarati": "^5.3.0",
    "@fontsource-variable/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/noto-sans-kannada": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource-variable/noto-sans-malayalam": "^5.3.0",
    "@fontsource-variable/noto-sans-oriya": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@ionic/pwa-elements": "^3.4.0",
    "clsx": "^2.1.1",
    "effect": "^4.0.5",
    "material-symbols": "^0.48.0",
    "snabbdom": "^3.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capacitor/cli": "^8.5.3",
    "@effect/tsgo": "0.53.3",
    "@types/bun": "^1.4.3",
    "bun-plugin-tailwind": "^0.1.2",
    "dprint": "^0.63.0",
    "fast-check": "^4.10.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
