{
  "name": "fridgy",
  "version": "2026.10.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#domain/*": "./src/domain/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#libs/jsx/jsx-runtime": "./src/libs/jsx/jsx-runtime.ts",
    "#libs/jsx/jsx-dev-runtime": "./src/libs/jsx/jsx-dev-runtime.ts",
    "#libs/*": "./src/libs/*",
    "#package.json": "./package.json"
  },
  "scripts": {
    "update-licenses": "bun ./scripts/cli.ts licenses",
    "update-palette": "bun ./scripts/cli.ts palette",
    "update-assets": "bun ./scripts/cli.ts assets",
    "build": "bun ./scripts/cli.ts build",
    "watch": "bun ./scripts/cli.ts watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts && oxlint --type-aware src scripts",
    "test": "bun test",
    "prepare": "effect-tsgo patch --typescript --no-oxlint && bun run update-licenses"
  },
  "dependencies": {
    "@capacitor/android": "9.0.0-alpha.8",
    "@capacitor/app": "9.0.0-alpha.2",
    "@capacitor/core": "9.0.0-alpha.8",
    "@capacitor/haptics": "9.0.0-next.1",
    "@capacitor/splash-screen": "9.0.0-alpha.2",
    "@capacitor/toast": "9.0.0-alpha.2",
    "@effect/platform-browser": "^4.0.6",
    "@effect/sql-sqlite-wasm": "^4.0.6",
    "@fgaudo/effect-tea": "^0.7.0",
    "@ionic/pwa-elements": "^3.4.0",
    "clsx": "^2.1.1",
    "effect": "^4.0.6",
    "material-symbols": "^0.48.1",
    "snabbdom": "^3.6.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@capacitor/cli": "9.0.0-alpha.8",
    "@effect/platform-bun": "^4.0.6",
    "@effect/tsgo": "0.53.3",
    "@material/material-color-utilities": "^0.4.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/subset-font": "^2.3.0",
    "dprint": "^0.63.0",
    "fast-check": "^4.10.2",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.4",
    "license-checker-rseidelsohn": "^5.0.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2"
  }
}
