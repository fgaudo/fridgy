{
  "name": "fridgy",
  "version": "2026.10.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "imports": {
    "#app/*": "./src/app/*",
    "#domain/*": "./src/domain/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#libs/*": "./src/libs/*",
    "#styles": "./src/styles.ts",
    "#package.json": "./package.json"
  },
  "codegenConfig": {
    "name": "FridgySpecs",
    "type": "all",
    "jsSrcsDir": "src/infrastructure/barcode-camera",
    "android": {
      "javaPackageName": "net.gaudo.fridgy.barcodecamera"
    }
  },
  "scripts": {
    "update-licenses": "bun ./scripts/cli.ts licenses",
    "update-android-licenses": "bun ./scripts/cli.ts android-licenses",
    "update-palette": "bun ./scripts/cli.ts palette",
    "update-icons": "bun ./scripts/cli.ts icons",
    "update-assets": "bun ./scripts/cli.ts assets",
    "bundle": "react-native bundle --platform android --dev false --entry-file src/entrypoints/native.tsx --bundle-output out/index.android.bundle --assets-dest out/assets",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts && oxlint --type-aware src scripts",
    "test": "bun test",
    "prepare": "effect-tsgo patch --typescript --no-oxlint && bun run update-icons"
  },
  "dependencies": {
    "@effect/sql-sqlite-react-native": "4.1.0",
    "@effect/sql-sqlite-wasm": "^4.1.0",
    "@fgaudo/effect-tea": "^0.7.1",
    "@op-engineering/op-sqlite": "18.2.5",
    "effect": "^4.1.0",
    "material-symbols": "^0.48.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "^1.22.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@biomejs/biome": "^2.6.4",
    "@effect/platform-bun": "^4.1.0",
    "@effect/tsgo": "0.63.0",
    "@material/material-color-utilities": "^0.4.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "dprint": "^0.64.3",
    "fast-check": "^4.10.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "wawoff2": "2.0.1"
  }
}
