{
  "name": "fridgy",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "update-licenses": "license-checker-rseidelsohn --excludePackages fridgy --json --customPath src/infrastructure/adapters/outbound/static/licenses/custom-path.json --out src/infrastructure/adapters/outbound/static/licenses/generated/licenses.json --depth 0",
    "build": "bun ./scripts/cli.ts build",
    "watch": "bun ./scripts/cli.ts watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts",
    "test": "bun test",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/splash-screen": "latest",
    "@capacitor/toast": "latest",
    "@effect/platform-browser": "^4",
    "@effect/platform-bun": "^4",
    "@effect/sql-sqlite-wasm": "^4",
    "@fontsource-variable/noto-sans": "latest",
    "@fontsource-variable/noto-sans-arabic": "latest",
    "@fontsource-variable/noto-sans-bengali": "latest",
    "@fontsource-variable/noto-sans-jp": "latest",
    "@fontsource-variable/noto-sans-kr": "latest",
    "@fontsource-variable/noto-sans-sc": "latest",
    "@fontsource/noto-sans": "latest",
    "@ionic/pwa-elements": "latest",
    "clsx": "latest",
    "csstype": "latest",
    "effect": "^4",
    "material-symbols": "latest",
    "snabbdom": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@capacitor/cli": "latest",
    "@effect/tsgo": "0.48.1",
    "@types/bun": "latest",
    "bun-plugin-tailwind": "latest",
    "dprint": "latest",
    "fast-check": "^4.10.2",
    "license-checker-rseidelsohn": "latest",
    "tailwindcss": "latest",
    "typescript": "^7"
  }
}
