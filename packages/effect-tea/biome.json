{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "root": false,
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useImportExtensions": "error"
      },
      "suspicious": { "recommended": false },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["snabbdom", "snabbdom/**", "react", "react/**", "react-dom", "react-dom/**"],
                "message": "@fgaudo/effect-tea is independent of the renderer: views are generic over their node type, and only the code that renders knows the renderer."
              }
            ]
          }
        }
      }
    }
  }
}
